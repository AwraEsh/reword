{
  "manifest_version": 3,
  "name": "Reword",
  "version": "0.1.0",
  "description": "Offline spelling correction for sites you enable.",
  "key": "",
  "permissions": [
    "activeTab",
    "nativeMessaging",
    "scripting"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "worker.js"
  },
  "action": {
    "default_title": "Reword",
    "default_popup": "popup.html"
  }
}
